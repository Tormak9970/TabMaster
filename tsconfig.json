{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "jsx": "react",
        "jsxFactory": "window.SP_REACT.createElement",
        "declaration": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "jsxFragmentFactory": "Fragment",
        "resolveJsonModule": true,
        "paths": {
            "@lib": ["./src/lib"],
            "@state": ["./src/state"],
            "@patches": ["./src/patches"],
            "@hooks": ["./src/hooks"],
            "@utils": ["./src/utils"],
            "@localization/*": ["./src/i18n/*"],
            "@types": ["./src/types"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
